{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/archive-session.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/archive-session.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Oturum dokumu .claude/sessions/ altina arsivleniyor"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-sessions.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-sessions.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 36500
}
