<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>860</height></rect>
  </property>
  <property name="windowTitle">
   <string>networkPlus</string>
  </property>
  <property name="dockNestingEnabled">
   <bool>true</bool>
  </property>
  <!-- Merkez bos ve gizli: diyagram da diger paneller gibi tasinabilir bir dock (dockDiagram). -->
  <widget class="QWidget" name="centralwidget"/>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect><x>0</x><y>0</y><width>1440</width><height>21</height></rect>
   </property>
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>&amp;Dosya</string></property>
    <addaction name="actOpenSnapshot"/>
    <addaction name="actSaveSnapshot"/>
    <addaction name="actExportPng"/>
    <addaction name="separator"/>
    <addaction name="actLive"/>
    <addaction name="actRelaunchAdmin"/>
    <addaction name="separator"/>
    <addaction name="actQuit"/>
   </widget>
   <widget class="QMenu" name="menuView">
    <property name="title"><string>&amp;Görünüm</string></property>
    <addaction name="actRefresh"/>
    <addaction name="actAutoRefresh"/>
    <addaction name="separator"/>
    <addaction name="actShowHidden"/>
    <addaction name="actRelayout"/>
    <addaction name="actFit"/>
    <addaction name="actResetLayout"/>
    <addaction name="separator"/>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title"><string>&amp;Yardım</string></property>
    <addaction name="actAbout"/>
   </widget>
   <widget class="QMenu" name="menuChanges">
    <property name="title"><string>&amp;Değişiklikler</string></property>
    <addaction name="actUndo"/>
    <addaction name="actRedo"/>
    <addaction name="separator"/>
    <addaction name="actApply"/>
    <addaction name="actReviewPlan"/>
    <addaction name="actClearChanges"/>
   </widget>
   <widget class="QMenu" name="menuSettings">
    <property name="title"><string>&amp;Ayarlar</string></property>
    <widget class="QMenu" name="menuAutostart">
     <property name="title"><string>Sistemle başlat</string></property>
     <addaction name="actAutostartOff"/>
     <addaction name="actAutostartUser"/>
     <addaction name="actAutostartAdmin"/>
    </widget>
    <widget class="QMenu" name="menuLanguage">
     <property name="title"><string>Dil</string></property>
     <addaction name="actLanguageAuto"/>
     <addaction name="separator"/>
    </widget>
    <widget class="QMenu" name="menuTheme">
     <property name="title"><string>Tema</string></property>
     <addaction name="actThemeAuto"/>
     <addaction name="actThemeSystem"/>
     <addaction name="separator"/>
     <addaction name="separator"/>
     <addaction name="actOpenThemesFolder"/>
    </widget>
    <addaction name="menuLanguage"/>
    <addaction name="menuTheme"/>
    <addaction name="menuAutostart"/>
    <addaction name="actElevateOnStart"/>
    <addaction name="separator"/>
    <addaction name="actConfirmRisky"/>
    <addaction name="actQueueMode"/>
    <addaction name="separator"/>
