   </widget>
   <!-- Tepsi menusu: menu cubuguna EKLENMEZ (addaction yok); sistem tepsisi simgesinde acilir.
        Bagdastiricilar alt menusu kodda en uste eklenir. -->
   <widget class="QMenu" name="menuTray">
    <property name="title"><string>Tepsi</string></property>
    <addaction name="actTrayShow"/>
    <addaction name="separator"/>
    <addaction name="actRefresh"/>
    <addaction name="actApply"/>
    <addaction name="separator"/>
    <addaction name="actCloseToTray"/>
    <addaction name="actNotifications"/>
    <addaction name="separator"/>
    <addaction name="actQuitApp"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuView"/>
   <addaction name="menuChanges"/>
   <addaction name="menuSettings"/>
   <addaction name="menuHelp"/>
  </widget>
  <widget class="QToolBar" name="mainToolBar">
   <property name="windowTitle"><string>Araç çubuğu</string></property>
   <property name="movable"><bool>false</bool></property>
   <property name="toolButtonStyle"><enum>Qt::ToolButtonTextOnly</enum></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
   <addaction name="actRefresh"/>
   <addaction name="actAutoRefresh"/>
   <addaction name="separator"/>
   <addaction name="actShowHidden"/>
   <addaction name="separator"/>
   <addaction name="actUndo"/>
   <addaction name="actRedo"/>
   <addaction name="actApply"/>
   <addaction name="separator"/>
   <addaction name="actOpenSnapshot"/>
